# Copia este archivo como .env y rellena con tus credenciales reales
# NUNCA subas .env a GitHub

# Ruta al archivo de credenciales de Firebase Admin SDK
# Descárgalo desde Firebase Console → Configuración del proyecto → Cuentas de servicio
FIREBASE_CREDENTIALS=./firebase-credentials.json

# Nombre del bucket de Firebase Storage (sin gs://)
FIREBASE_BUCKET=portal-de-recuerdos.firebasestorage.app

# ElevenLabs
ELEVENLABS_API_KEY=tu_api_key_aqui
ELEVENLABS_VOICE_ID=tu_voice_id_aqui